# ── Dataform project config ────────────────────────────────────────────────────
# Edit workflow_settings.yaml and set:
#   defaultProject: your-gcp-project-here
#   vars:
#     gcs_parquet_path: gs://your-bucket-here/parquet

# ── Data generator ─────────────────────────────────────────────────────────────
# Local directory where generate.py writes parquet files before upload to GCS.
# Defaults to generator/output/ if not set.
export INPUT_FILES_PATH=./generator/output

# Everything below has a default; set none of it and the generator still runs.
#
# Seeds random and Faker. Same seed, same dataset.
# export SEED=42
#
# Direct sales transactions. The reseller feeds are a fixed 100,000 rows each.
# export N_TRANSACTIONS=1000000
#
# The sales window: DATA_WINDOW_MONTHS back from DATA_END_DATE, both ends
# inclusive. DATA_END_DATE defaults to today, which is what keeps the
# dashboards current -- and what makes SEED alone insufficient to reproduce a
# dataset. Pin it to an ISO date to regenerate an earlier one exactly.
# The window has to stay inside dim_date; see includes/calendar.js.
# export DATA_WINDOW_MONTHS=24
# export DATA_END_DATE=2026-09-13

# After running the generator, upload the parquet files to GCS:
#   gsutil -m cp ./generator/output/*.parquet gs://your-bucket-here/parquet/
