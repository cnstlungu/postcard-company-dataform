config {
  type: "operations",
  schema: "parquet_input",
  name: "channels",
  description: "Master data: the channels a sale can come through (webshop, phone, reseller and so on). Reference data, rewritten whole on every run.",
  tags: ["sources", "schedule_daily"],
  hasOutput: true
}

CREATE SCHEMA IF NOT EXISTS `${database()}.${schema()}`;

CREATE OR REPLACE EXTERNAL TABLE ${self()}
OPTIONS (
  format = 'PARQUET',
  uris = ['${dataform.projectConfig.vars.input_files_path}/channels.parquet']
)
