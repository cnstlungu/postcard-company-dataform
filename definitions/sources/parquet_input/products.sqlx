config {
  type: "operations",
  schema: "parquet_input",
  name: "products",
  description: "Master data: the postcard catalogue, including the list price that `dim_product` tracks. Rewritten whole on every run.",
  tags: ["sources", "schedule_daily"],
  hasOutput: true
}

CREATE SCHEMA IF NOT EXISTS `${database()}.${schema()}`;

CREATE OR REPLACE EXTERNAL TABLE ${self()}
OPTIONS (
  format = 'PARQUET',
  uris = ['${dataform.projectConfig.vars.input_files_path}/products.parquet']
)
