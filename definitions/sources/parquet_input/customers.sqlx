config {
  type: "operations",
  schema: "parquet_input",
  name: "customers",
  description: "Master data: one row per direct customer, with the address the geography dimension is built from. Rewritten whole on every run.",
  tags: ["sources", "schedule_daily"],
  hasOutput: true
}

CREATE SCHEMA IF NOT EXISTS `${database()}.${schema()}`;

CREATE OR REPLACE EXTERNAL TABLE ${self()}
OPTIONS (
  format = 'PARQUET',
  uris = ['${dataform.projectConfig.vars.input_files_path}/customers.parquet']
)
