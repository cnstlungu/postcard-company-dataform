config {
  type: "assertion",
  name: "dim_date_contract",
  tags: ["contract", "assertions"],
  description: "Port of the dbt model contract on dim_date. dbt checks it before building; this checks the built table."
}

-- dbt enforced a contract on this model: exactly these columns, with these types.
WITH expected AS (
  SELECT * FROM UNNEST([
    STRUCT('date_key' AS column_name, 'INT64' AS data_type),
    STRUCT('date_value' AS column_name, 'DATE' AS data_type),
    STRUCT('day_of_year' AS column_name, 'INT64' AS data_type),
    STRUCT('week_key' AS column_name, 'INT64' AS data_type),
    STRUCT('week_of_year' AS column_name, 'INT64' AS data_type),
    STRUCT('day_of_week' AS column_name, 'INT64' AS data_type),
    STRUCT('iso_day_of_week' AS column_name, 'INT64' AS data_type),
    STRUCT('day_name' AS column_name, 'STRING' AS data_type),
    STRUCT('first_day_of_week' AS column_name, 'DATE' AS data_type),
    STRUCT('last_day_of_week' AS column_name, 'DATE' AS data_type),
    STRUCT('month_key' AS column_name, 'STRING' AS data_type),
    STRUCT('month_of_year' AS column_name, 'INT64' AS data_type),
    STRUCT('day_of_month' AS column_name, 'INT64' AS data_type),
    STRUCT('month_name_short' AS column_name, 'STRING' AS data_type),
    STRUCT('month_name' AS column_name, 'STRING' AS data_type),
    STRUCT('first_day_of_month' AS column_name, 'DATE' AS data_type),
    STRUCT('last_day_of_month' AS column_name, 'DATE' AS data_type),
    STRUCT('quarter_key' AS column_name, 'INT64' AS data_type),
    STRUCT('quarter_of_year' AS column_name, 'INT64' AS data_type),
    STRUCT('day_of_quarter' AS column_name, 'INT64' AS data_type),
    STRUCT('quarter_desc_short' AS column_name, 'STRING' AS data_type),
    STRUCT('quarter_desc' AS column_name, 'STRING' AS data_type),
    STRUCT('first_day_of_quarter' AS column_name, 'DATE' AS data_type),
    STRUCT('last_day_of_quarter' AS column_name, 'DATE' AS data_type),
    STRUCT('year_key' AS column_name, 'INT64' AS data_type),
    STRUCT('first_day_of_year' AS column_name, 'DATE' AS data_type),
    STRUCT('last_day_of_year' AS column_name, 'DATE' AS data_type),
    STRUCT('ordinal_weekday_of_month' AS column_name, 'INT64' AS data_type)
  ])
),

actual AS (
  SELECT column_name, data_type
  FROM ${dbt2dataform.information_schema_columns(ref("dim_date"))}
)

SELECT
  COALESCE(e.column_name, a.column_name) AS column_name,
  e.data_type AS expected_type,
  a.data_type AS actual_type
FROM expected AS e
FULL OUTER JOIN actual AS a ON LOWER(e.column_name) = LOWER(a.column_name)
WHERE e.column_name IS NULL OR a.column_name IS NULL OR e.data_type != a.data_type
