config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_core",
  tags: ["core", "schedule_daily"],
  description: "Resellers selling on the company's behalf, plus a synthetic agent representing direct sales. Carries the commission rate applied to reseller transactions.",
  columns: {
    commission_pct: "Commission rate applied to this agent's sales."
  },
  assertions: {
    uniqueKeys: [["sales_agent_key"]],
    nonNull: ["sales_agent_key"]
  }
}

post_operations {
  ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
  ALTER TABLE ${self()} ADD PRIMARY KEY (sales_agent_key) NOT ENFORCED
}

SELECT
  reseller_id AS sales_agent_key,
  reseller_id AS original_reseller_id,
  reseller_name,
  commission_pct
FROM ${ref("staging_resellers")}
UNION ALL
SELECT
  0 AS sales_agent_key,
  0 AS original_reseller_id,
  'Direct Sales' AS reseller_name,
  NULL AS commission_pct
