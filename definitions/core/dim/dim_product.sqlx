config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_core",
  tags: ["core", "schedule_daily"],
  description: "The postcard catalogue: one row per product, with its depicted city and list price.",
  columns: {
    product_price: "List price. Asserted to be strictly positive."
  },
  assertions: {
    uniqueKeys: [["product_key"]],
    nonNull: ["product_key"],
    rowConditions: ["product_price > 0"]
  }
}

post_operations {
  ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
  ALTER TABLE ${self()} ADD PRIMARY KEY (product_key) NOT ENFORCED
}

SELECT
  product_key,
  product_id AS original_product_id,
  product_name,
  geography_key,
  product_price
FROM ${ref("staging_products")}
