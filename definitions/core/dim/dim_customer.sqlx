config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_core",
  tags: ["core", "schedule_daily"],
  description: "Customers unified across all three sources. Direct customers key off their source customer_id; reseller customers have no stable identifier, so they key off (reseller_id, email).",
  columns: {
    customer_key: "Surrogate key. Derived from (0, customer_id) for direct customers and (reseller_id, email) for reseller customers."
  },
  assertions: {
    uniqueKeys: [["customer_key"]],
    nonNull: ["customer_email", "customer_key"]
  }
}

post_operations {
  ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
  ALTER TABLE ${self()} ADD PRIMARY KEY (customer_key) NOT ENFORCED
}

SELECT
  customer_key,
  original_customer_id,
  customer_first_name,
  customer_last_name,
  customer_email,
  customer_phone,
  customer_address,
  customer_city,
  customer_country,
  customer_postal_code,
  sales_agent_key
FROM ${ref("staging_customers")}
