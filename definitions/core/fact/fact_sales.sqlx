config {
  type: "incremental",
  schema: dataform.projectConfig.defaultSchema + "_core",
  tags: ["core", "schedule_daily"],
  description: "One row per sale, unioned from direct sales and both reseller feeds. Grain is one transaction per sales agent, so sales_key is the surrogate key over (sales_agent_key, transaction_id).",
  columns: {
    sales_key: "Surrogate key over (sales_agent_key, transaction_id). Unique because transaction_id is globally unique across sources.",
    bought_date_key: "Integer date of the sale in YYYYMMDD form. Tested against dim_date so that a sale generated outside the calendar fails the build instead of quietly dropping out of every date-based report.",
    commissionpaid: "Commission value on this sale. Null for direct sales.",
    commissionpct: "Commission rate for the selling agent. Null for direct sales, which pay no commission.",
    total_amount: "Gross line value: quantity multiplied by the product price at time of sale.",
    transaction_id: "Transaction identifier from the source system. Unique across all three feeds."
  },
  uniqueKey: ["sales_key"],
  onSchemaChange: "FAIL",
  assertions: {
    uniqueKeys: [["sales_key"]],
    nonNull: [
      "bought_date_key",
      "channel_key",
      "customer_key",
      "geography_key",
      "product_key",
      "qty",
      "sales_key",
      "total_amount"
    ]
  },
  bigquery: {
    partitionBy: "RANGE_BUCKET(bought_date_key, GENERATE_ARRAY(20100101, 20360101, 10000))",
    clusterBy: ["channel_key", "sales_agent_key"]
  }
}

SELECT
  ${dbt_utils.generate_surrogate_key(["sales_agent_key", "transaction_id"])} AS sales_key,
  customer_key,
  transaction_id,
  product_key,
  channel_key,
  bought_date_key,
  geography_key,
  sales_agent_key,
  total_amount,
  qty,
  commissionpct,
  commissionpaid,
  product_price
FROM ${ref("staging_transactions")} AS t
LEFT JOIN ${ref("dim_sales_agent")} AS sa
  ON t.reseller_id = sa.original_reseller_id
