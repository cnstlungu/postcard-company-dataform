config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_raw",
  tags: ["raw", "schedule_daily"],
  description: "Passthrough of the type 1 reseller feed, which arrives with human-readable spaced column names. Renaming happens in staging."
}

SELECT
  Product_name,
  Quantity,
  Total_amount,
  Sales_Channel,
  Customer_First_Name,
  Customer_Last_Name,
  Customer_Email,
  Customer_Phone,
  Customer_Address,
  Customer_City,
  Customer_Country,
  Customer_Postal_Code,
  Series_City,
  Created_Date,
  Reseller_ID,
  Transaction_ID,
  CURRENT_TIMESTAMP() AS loaded_timestamp
FROM ${ref("parquet_input", "resellers_type1")}
