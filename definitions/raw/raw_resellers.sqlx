config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_raw",
  tags: ["raw", "schedule_daily"],
  description: "Passthrough of the reseller reference extract, with a load timestamp."
}

SELECT
  reseller_id,
  reseller_name,
  commission_pct,
  CURRENT_TIMESTAMP() AS loaded_timestamp
FROM ${ref("parquet_input", "resellers")}
