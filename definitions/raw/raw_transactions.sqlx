config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_raw",
  tags: ["raw", "schedule_daily"],
  description: "Passthrough of the direct-sales transaction extract, with a load timestamp."
}

SELECT
  transaction_id,
  customer_id,
  product_id,
  amount,
  CAST(qty AS INT64) AS qty,
  channel_id,
  bought_date,
  CURRENT_TIMESTAMP() AS loaded_timestamp
FROM ${ref("parquet_input", "main")}
