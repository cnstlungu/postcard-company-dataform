config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_raw",
  tags: ["raw", "schedule_daily"],
  description: "Passthrough of the channels extract, with a load timestamp. No business logic."
}

SELECT
  channel_name,
  CAST(channel_id AS INT64) AS channel_id,
  CURRENT_TIMESTAMP() AS loaded_timestamp
FROM ${ref("parquet_input", "channels")}
