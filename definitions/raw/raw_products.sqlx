config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_raw",
  tags: ["raw", "schedule_daily"],
  description: "Passthrough of the product catalogue extract, with a load timestamp."
}

SELECT
  name,
  city,
  price,
  product_id,
  CURRENT_TIMESTAMP() AS loaded_timestamp
FROM ${ref("parquet_input", "products")}
