config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_raw",
  tags: ["raw", "schedule_daily"],
  description: "Passthrough of the direct-customer extract, with a load timestamp."
}

SELECT
  customer_id,
  first_name,
  last_name,
  email,
  phone_number,
  address,
  city,
  country,
  postal_code,
  CURRENT_TIMESTAMP() AS loaded_timestamp
FROM ${ref("parquet_input", "customers")}
