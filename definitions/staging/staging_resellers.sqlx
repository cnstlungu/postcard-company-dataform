config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_staging",
  tags: ["staging", "schedule_daily"],
  description: "Resellers deduplicated to the latest row per reseller_id.",
  columns: {
    reseller_id: "Source reseller identifier."
  },
  assertions: {
    uniqueKeys: [["reseller_id"]],
    nonNull: ["reseller_id"]
  }
}

SELECT
  CAST(reseller_id AS INT64) AS reseller_id,
  reseller_name,
  commission_pct
FROM ${ref("raw_resellers")}
QUALIFY
  ROW_NUMBER() OVER (PARTITION BY reseller_id ORDER BY loaded_timestamp DESC) = 1
