config {
  type: "incremental",
  schema: dataform.projectConfig.defaultSchema + "_staging",
  tags: ["staging", "schedule_daily"],
  description: "Type 2 reseller sales, renamed and typed. Incremental on the (reseller_id, transaction_id) grain.",
  columns: {
    transaction_id: "Transaction identifier, unique only within a reseller.",
    reseller_id: "Reseller this sale belongs to."
  },
  uniqueKey: ["reseller_id", "transaction_id"],
  onSchemaChange: "FAIL",
  assertions: {
    uniqueKeys: [["reseller_id", "transaction_id"]],
    nonNull: ["reseller_id", "transaction_id"]
  },
  bigquery: {
    partitionBy: "RANGE_BUCKET(bought_date_key, GENERATE_ARRAY(20100101, 20360101, 10000))"
  }
}

-- transaction_id is only unique within a reseller, so the grain of this model is
-- the pair. Keying on transaction_id alone would let an incremental run collapse
-- two resellers' rows into one.
WITH latest_transaction AS (
  SELECT
${when(incremental(), `    MAX(loaded_timestamp) AS max_transaction_timestamp
  FROM ${self()}`, `    CAST('1900-01-01' AS DATETIME) AS max_transaction_timestamp`)}
), trans_resellers AS (
  SELECT
    ${dbt_utils.generate_surrogate_key(["reseller_id", "customer_email"])} AS customer_key,
    productName AS product_name,
    qty AS quantity,
    totalAmount AS total_amount,
    salesChannel AS sales_channel,
    customer_first_name,
    customer_last_name,
    customer_email,
    seriesCity AS series_city,
    Created_Date AS created_date,
    reseller_id AS reseller_id,
    `transactionID` AS transaction_id,
    CURRENT_TIMESTAMP() AS loaded_timestamp
  FROM ${ref("raw_reseller_type2_sales")}
${when(incremental(), `  WHERE
    loaded_timestamp > (
      SELECT
        max_transaction_timestamp
      FROM latest_transaction
      LIMIT 1
    )`)}
)
SELECT
  t.customer_key,
  transaction_id,
  t.product_name,
  p.product_key,
  c.channel_key,
  t.reseller_id,
  CAST(FORMAT_DATE('%Y%m%d', CAST(created_date AS DATE)) AS INT64) AS bought_date_key,
  CAST(total_amount AS NUMERIC) AS total_amount,
  CAST(quantity AS INT64) AS quantity,
  CAST(p.product_price AS NUMERIC) AS product_price,
  p.geography_key,
  s.commission_pct * CAST(total_amount AS NUMERIC) AS commissionpaid,
  s.commission_pct AS commissionpct,
  loaded_timestamp,
  created_date
FROM trans_resellers AS t
LEFT JOIN ${ref("dim_product")} AS p
  ON t.product_name = p.product_name
LEFT JOIN ${ref("dim_channel")} AS c
  ON t.sales_channel = c.channel_name
LEFT JOIN ${ref("dim_customer")} AS cu
  ON t.customer_key = cu.customer_key
LEFT JOIN ${ref("dim_sales_agent")} AS s
  ON t.reseller_id = s.original_reseller_id
