config {
  type: "table",
  schema: dataform.projectConfig.defaultSchema + "_staging",
  tags: ["staging", "schedule_daily"],
  description: "All sales from the three feeds unioned into one shape, ready for the fact table.",
  columns: {
    transaction_id: "Source transaction identifier. Unique across the union; this guards the id collision that used to exist between reseller feeds."
  },
  assertions: {
    uniqueKeys: [["transaction_id"]],
    nonNull: ["transaction_id"]
  }
}

SELECT
  customer_key,
  transaction_id,
  product_key,
  channel_key,
  reseller_id,
  bought_date_key,
  total_amount,
  qty,
  product_price,
  geography_key,
  commissionpaid,
  commissionpct,
  loaded_timestamp
FROM ${ref("staging_transactions_main")}
UNION ALL
SELECT
  customer_key,
  transaction_id,
  product_key,
  channel_key,
  reseller_id,
  bought_date_key,
  total_amount,
  quantity,
  product_price,
  geography_key,
  commissionpaid,
  commissionpct,
  loaded_timestamp
FROM ${ref("staging_reseller_type1_sales")}
UNION ALL
SELECT
  customer_key,
  transaction_id,
  product_key,
  channel_key,
  reseller_id,
  bought_date_key,
  total_amount,
  quantity,
  product_price,
  geography_key,
  commissionpaid,
  commissionpct,
  loaded_timestamp
FROM ${ref("staging_reseller_type2_sales")}
