config {
  type: "incremental",
  schema: dataform.projectConfig.defaultSchema + "_staging",
  tags: ["staging", "schedule_daily"],
  description: "Direct sales, loaded incrementally on loaded_timestamp.",
  columns: {
    transaction_id: "Source transaction identifier, globally unique across feeds."
  },
  uniqueKey: ["transaction_id"],
  onSchemaChange: "FAIL",
  assertions: {
    uniqueKeys: [["transaction_id"]],
    nonNull: ["transaction_id"]
  },
  bigquery: {
    partitionBy: "RANGE_BUCKET(bought_date_key, GENERATE_ARRAY(20100101, 20360101, 10000))"
  }
}

${when(incremental(), `WITH latest_transaction AS (
  SELECT
    MAX(loaded_timestamp) AS max_transaction
  FROM ${self()}
), trans_main AS (`, `WITH trans_main AS (`)}
  SELECT
    ${dbt_utils.generate_surrogate_key(["0", "customer_id"])} AS customer_key,
    customer_id,
    transaction_id,
    product_id,
    amount,
    qty,
    channel_id,
    bought_date,
    loaded_timestamp
  FROM ${ref("raw_transactions")}
${when(incremental(), `  /* this filter will only be applied on an incremental run */
  WHERE
    loaded_timestamp > (
      SELECT
        max_transaction
      FROM latest_transaction
      LIMIT 1
    )`)}
)
SELECT
  t.customer_key,
  transaction_id,
  p.product_key,
  c.channel_key,
  0 AS reseller_id,
  CAST(FORMAT_DATETIME('%Y%m%d', CAST(bought_date AS DATETIME)) AS INT64) AS bought_date_key,
  amount AS total_amount,
  qty,
  p.product_price,
  p.geography_key,
  CAST(NULL AS NUMERIC) AS commissionpaid,
  CAST(NULL AS NUMERIC) AS commissionpct,
  loaded_timestamp
FROM trans_main AS t
LEFT JOIN ${ref("dim_product")} AS p
  ON t.product_id = p.original_product_id
LEFT JOIN ${ref("dim_channel")} AS c
  ON t.channel_id = c.channel_key
LEFT JOIN ${ref("dim_customer")} AS cu
  ON t.customer_key = cu.customer_key
